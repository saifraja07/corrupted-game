{
  "name": "corrupted",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:build": "node tools/check-build.mjs",
    "sounds": "python3 tools/generate-sounds.py",
    "verify": "npm run lint && npm test && npm run build && npm run check:build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "howler": "^2.2.4",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Corrupted: Find the exit. Trust nothing. A first-person 3D troll puzzle game that slowly corrupts. Runs entirely in the browser.",
  "engines": {
    "node": ">=20"
  }
