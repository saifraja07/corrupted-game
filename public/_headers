# Cloudflare Pages / Netlify style headers.
# Hashed build output never changes under the same name, so it can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sounds keep stable names, so cache for a week rather than forever.
/sounds/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
